; pulling.mdp
integrator       = md
tinit            = 0
dt               = 0.002
nsteps           = 500000  ; 1 ns = 500000 steps x 0.002 ps
nstxout          = 5000
nstvout          = 5000
nstenergy        = 1000
nstlog           = 1000
continuation     = no
constraint_algorithm = lincs
constraints      = all-bonds
lincs_iter       = 1
lincs_order      = 4
cutoff-scheme    = Verlet
ns_type          = grid
nstlist          = 10
rcoulomb         = 1.0
rvdw             = 1.0
coulombtype      = PME
pbc              = xyz
tcoupl           = V-rescale
tc-grps          = System
tau_t            = 0.1
ref_t            = 300
pcoupl           = no

; Pull code setup
pull                    = yes
pull-ngroups            = 2
pull-ncoords            = 1
pull-group1-name        = RG35
pull-group2-name        = RNA
pull-coord1-type        = umbrella
pull-coord1-geometry    = distance
pull-coord1-groups      = 1 2
pull-coord1-dim         = Y N N  ; change to X Y Z as needed
pull-coord1-start       = yes
pull-coord1-rate        = 0.01   ; nm/ps (adjust as needed)
pull-coord1-k           = 1000   ; kJ/mol/nm^2
