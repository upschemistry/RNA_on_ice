; VARIOUS PREPROCESSING OPTIONS
;title                    = Ice/waterTIP4PD_RNA
;cpp                      = /usr/bin/cpp
include                  =
define                   =

; RUN CONTROL PARAMETERS
integrator               = md
dt                       = 0.001
;nsteps                    = 100000; 100 ps or 0.1 ns
;nsteps                    = 1000000; 1000 ps or 1 ns
nsteps                    = 100000000; 100000 ps or 100 ns
;nsteps                    = 500000000; 500000 ps or 500 ns
;nsteps                   = 100000  ; 
;nsteps                   = 500000  ;
;nsteps                   = 5000000  ; 

; mode for center of mass motion removal
comm-mode                = Linear
; number of steps for center of mass motion removal
nstcomm                  = 1000
; group(s) for center of mass motion removal
comm-grps                = SOL  ;the solvent is the center of the system.

; Output control
nstxout     = 100000       ; every 100 ps
nstvout     = 100000       ; every 100 ps
nstfout     = 0       ; not save force 
nstenergy   = 10000    ; save energies every 10 ps
nstlog      = 10000    ; update log file every 10 ps
;nstxtcout   = 100000   ; every 100 ps

; Bond parameters
continuation    = no ; first dynamics run
constraint_algorithm = lincs    ; holonomic constraints 
constraints     = h-bonds     ; all bonds (even heavy atom-H bonds) constrained
lincs_iter      = 1             ; accuracy of LINCS
lincs_order     = 4             ; also related to accuracy

; Neighborsearching
cutoff-scheme   = Verlet
ns_type         = grid      ; search neighboring grid cells
nstlist         = 10        ; 20 fs, largely irrelevant with Verlet
rcoulomb        = 1.0       ; short-range electrostatic cutoff (in nm)
rvdw            = 1.0       ; short-range van der Waals cutoff (in nm)

; Periodic boundary conditions
pbc         = xyz       ; 3-D PBC

; OPTIONS FOR ELECTROSTATICS AND VDW
coulombtype              = PME          ; Method for doing electrostatics
vdw-type                 = PME      ; Method for doing VdW
DispCorr                 = no ;EnerPres;          ; Apply long range dispersion corrections for energy and/or pressure
fourierspacing           = 0.12         ; Spacing for the PME/PPPM FFT grid
pme_order                = 4
ewald_rtol               = 1e-05
ewald_geometry           = 3d          ; 3d is 'normal', 3dc has a correction for a system with a net dipole
epsilon_surface          = 0
;optimize_fft             = yes          ; Optimize FFT for large systems.

; OPTIONS FOR WEAK COUPLING ALGORITHMS
Tcoupl                   = v-rescale    ; Temperature coupling algorithm
;tc-grps                  = Water_and_ions RNA       ; Groups to couple separately
;ref_t                    = 220 220        ; Reference temperature (K)
;tau_t                    = 0.1 0.1        ; Time constant (ps)
tc-grps                  = System       ; Groups to couple separately
ref_t                    = 245       ; Reference temperature (K)
tau_t                    = 0.1        ; Time constant (ps)
Pcoupl                   = no ;Parrinello-Rahman           ; Pressure coupling algorithm

; GENERATE VELOCITIES FOR STARTUP RUN
gen_vel                  = yes
gen_temp                 = 245
gen_seed                 = 1993

; Trying to keep the slab from moving around
freezegrps               = frozen
freezedim                = Y Y N


;freezegrps                = RNA NA
;freezedim                 = Y Y N Y Y N
